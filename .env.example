# Server
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
READ_TIMEOUT=30s
WRITE_TIMEOUT=30s
MAX_HEADER_BYTES=1048576

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_NAME=tg_sender
DB_SSLMODE=disable
DB_MAX_CONNS=20
DB_MAX_IDLE=5
DB_MAX_LIFE=30m
DB_MAX_IDLE_TIME=10m

# JWT (required, minimum 32 characters)
JWT_SECRET=your-32-char-long-secret-key-here
JWT_EXPIRY=24h
JWT_REFRESH_EXP=168h

# Telegram (required - get from https://my.telegram.org)
TG_API_ID=your_api_id_here
TG_API_HASH=your_api_hash_here

# App
ENV=production
LOG_LEVEL=info
LOG_FILE=
MAX_ACCOUNTS=20
MAX_CONCURRENT=5
